# FounderOS Backend Environment Configuration Example
PROJECT_NAME="FounderOS Backend"
API_V1_STR="/api"
DATABASE_URL="sqlite+aiosqlite:///./founderos.db"
# Secret key used for AES-256-GCM Vault encryption (32-byte hex or urlsafe base64 string)
# If empty, a persistent machine-derived key is used.
VAULT_KEY=""

